{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "task_id": { "type": "string" },
    "agent_role": {
      "type": "string",
      "enum": ["planner", "frontend", "backend", "devops", "reviewer"]
    },
    "scope": {
      "type": "object",
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "restricted_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "upstream_evidence": {
      "type": "object",
      "description": "Proof that the previous agent completed its work successfully.",
      "properties": {
        "commit_hash": { "type": "string" },
        "pipeline_status": { "type": "string" }
      }
    },
    "expected_deliverables": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["task_id", "agent_role", "scope", "expected_deliverables"]
}
